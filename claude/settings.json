{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {},
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '.stop_hook_active == true' >/dev/null 2>&1 || echo '{\"decision\":\"block\",\"reason\":\"invoke the simplify-reply skill\",\"suppressOutput\":true}'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/fork-watch.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/fork-watch-end.sh"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "remoteControlAtStartup": false,
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.237",
  "tui": "fullscreen",
  "theme": "dark",
  "feedbackSurveyState": {
    "lastShownTime": 1754207903141
  },
  "permissions": {
    "additionalDirectories": [
      "/home/astral100/ClaudeBugFixes"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git commit *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push * --delete *)"
    ]
  }
}
